# Free key from https://console.groq.com/keys
# Without it the app runs in demo mode: the seeded notices, the candidate check and the photo
# fixer all work, and only the made-up demo notice in test/fixtures can be read.
GROQ_API_KEY=

# Models (all open-weight, served by Groq by default)
# READ_MODEL=openai/gpt-oss-120b        # exam, dates, fees, age limits
# READ_MODEL_SMALL=openai/gpt-oss-20b   # photo and signature sizes, documents, Hindi for the slip
# READ_MODEL_SIDE=qwen/qwen3.8-27b      # who can apply

# Run against any other OpenAI-compatible server instead (Ollama, vLLM, llama.cpp).
# The free-tier pacing switches off unless you set LLM_TOKENS_PER_MINUTE.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_TOKENS_PER_MINUTE=8000

# Keep notices across restarts (free MongoDB Atlas M0 cluster). Without it they go to a JSON file.
# MONGODB_URI=
# DATA_DIR=./data

PORT=4200
